# Copy to .env to override defaults. Optional: the app runs without it.
# Never commit .env or real secrets.

# Which receipt extractor to use: mock | ollama (only mock exists so far)
EXTRACTOR=mock

# Where the SQLite database file lives. A relative path is relative to where the app starts
# (the repo root in venv mode, /app in Docker). Default shown.
DATABASE_URL=sqlite:///data/app.db
